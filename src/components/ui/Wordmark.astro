---
/**
 * Wordmark - the official DEVRA lockup: "DEVRA" in brand red with
 * "CLINIC & DIAGNOSTICS" spaced beneath it. No icon (matches the real logo).
 * `tone="light"` renders the subtitle on dark backgrounds (footer).
 */
interface Props {
	tone?: "default" | "light";
	class?: string;
}

const { tone = "default", class: className = "" } = Astro.props;

const suffixColor = tone === "light" ? "text-white/85" : "text-ink";
---

<a
	href="/"
	class={`inline-flex flex-col leading-none ${className}`}
	aria-label="Devra Clinic & Diagnostics, home"
>
	<span class="text-2xl font-extrabold uppercase tracking-tight text-logo">
		DEVRA
	</span>
	<span
		class={`mt-1 text-[0.6rem] font-bold uppercase tracking-[0.2em] ${suffixColor}`}
	>
		Clinic &amp; Diagnostics
	</span>
</a>
