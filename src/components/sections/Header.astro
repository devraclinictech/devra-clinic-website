---
/**
 * Header - sticky top bar: wordmark, anchor nav, click-to-call, and a primary
 * "Book Appointment" CTA. On large screens the nav sits inline; below `lg` it
 * collapses into a hamburger that toggles a drop-down panel.
 */
import Wordmark from "../ui/Wordmark.astro";
import Button from "../ui/Button.astro";
import Icon from "../ui/Icon.astro";
import LanguageToggle from "../ui/LanguageToggle.astro";
import { clinic, nav } from "../../data/site.ts";

// Header shows a trimmed menu; About and Visit Us live in the footer only.
const headerNav = nav.filter((item) => item.header);
---

<header
	class="sticky top-0 z-50 border-b border-line bg-surface/90 backdrop-blur"
>
	<div
		class="mx-auto flex h-16 w-full max-w-content items-center justify-between px-5 sm:px-8"
	>
		<Wordmark />

		<nav aria-label="Primary" class="hidden items-center gap-7 lg:flex">
			{
				headerNav.map((item) => (
					<a
						href={item.hash}
						class="text-sm font-medium text-ink-muted transition-colors hover:text-brand"
					>
						{item.label}
					</a>
				))
			}
		</nav>

		<div class="flex items-center gap-2 sm:gap-3">
			<LanguageToggle />
			<a
				href={clinic.phoneHref}
				class="hidden items-center gap-2 text-sm font-semibold text-ink transition-colors hover:text-brand sm:inline-flex"
			>
				<Icon name="phone" class="h-4 w-4 text-brand" />
				{clinic.phoneDisplay}
			</a>
			<div class="hidden sm:block">
				<Button href={clinic.whatsappHref} data-booking-trigger="true">
					Book Appointment
				</Button>
			</div>

			<!-- Mobile hamburger -->
			<button
				id="mobile-nav-toggle"
				type="button"
				data-open="false"
				aria-label="Open menu"
				aria-controls="mobile-nav"
				aria-expanded="false"
				class="flex h-10 w-10 items-center justify-center rounded-card text-ink transition-colors hover:bg-surface-alt lg:hidden"
			>
				<Icon name="menu" class="h-6 w-6" data-icon="menu" />
				<Icon name="close" class="hidden h-6 w-6" data-icon="close" />
			</button>
		</div>
	</div>

	<!-- Mobile drop-down panel -->
	<div id="mobile-nav" class="border-t border-line bg-surface lg:hidden">
		<nav
			aria-label="Mobile"
			class="mx-auto flex w-full max-w-content flex-col px-5 py-3 sm:px-8"
		>
			{
				nav.map((item) => (
					<a
						href={item.hash}
						class="border-b border-line py-3 text-base font-medium text-ink transition-colors last:border-0 hover:text-brand"
					>
						{item.label}
					</a>
				))
			}
			<div class="mt-4 flex flex-col gap-3 pb-2">
				<a
					href={clinic.phoneHref}
					class="inline-flex items-center justify-center gap-2 rounded-pill border border-brand px-5 py-2.5 text-sm font-semibold text-brand transition-colors hover:bg-brand-tint"
				>
					<Icon name="phone" class="h-4 w-4" />
					{clinic.phoneDisplay}
				</a>
				<Button
					href={clinic.whatsappHref}
					data-booking-trigger="true"
					class="w-full"
				>
					Book Appointment
				</Button>
			</div>
		</nav>
	</div>
</header>

<script>
	const btn = document.getElementById("mobile-nav-toggle");
	const panel = document.getElementById("mobile-nav");

	if (btn && panel) {
		const iconMenu = btn.querySelector<HTMLElement>('[data-icon="menu"]');
		const iconClose = btn.querySelector<HTMLElement>('[data-icon="close"]');

		const setOpen = (open: boolean) => {
			panel.classList.toggle("is-open", open);
			btn.setAttribute("aria-expanded", String(open));
			btn.setAttribute("aria-label", open ? "Close menu" : "Open menu");
			iconMenu?.classList.toggle("hidden", open);
			iconClose?.classList.toggle("hidden", !open);
		};

		btn.addEventListener("click", () =>
			setOpen(!panel.classList.contains("is-open")),
		);

		// Close after tapping a link, on Escape, and when growing to desktop.
		panel
			.querySelectorAll("a")
			.forEach((a) => a.addEventListener("click", () => setOpen(false)));
		document.addEventListener("keydown", (event) => {
			if (event.key === "Escape") setOpen(false);
		});
		window.addEventListener("resize", () => {
			if (window.innerWidth >= 1024) setOpen(false);
		});
	}
</script>
