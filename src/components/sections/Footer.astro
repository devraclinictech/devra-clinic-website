---
/**
 * Footer - wordmark, quick links, contact line and copyright.
 */
import Wordmark from "../ui/Wordmark.astro";
import Icon from "../ui/Icon.astro";
import { clinic, nav, doctors } from "../../data/site.ts";

const year = new Date().getFullYear();
const doctorProfiles = doctors.filter((d) => d.profileHref);
---

<footer class="bg-ink text-white/70">
	<div class="mx-auto w-full max-w-content px-5 py-14 sm:px-8">
		<div
			class="flex flex-col gap-10 md:flex-row md:items-start md:justify-between"
		>
			<div class="max-w-sm">
				<Wordmark tone="light" />
				<p class="mt-4 text-sm leading-relaxed">
					{clinic.intro}
				</p>
			</div>

			<div class="grid grid-cols-2 gap-10 sm:grid-cols-3 sm:gap-12">
				<div class="min-w-0">
					<h4 class="text-sm font-semibold text-white">Explore</h4>
					<ul class="mt-4 space-y-2.5 text-sm">
						{
							nav.map((item) => (
								<li>
									<a
										href={item.page}
										class="transition-colors hover:text-white"
									>
										{item.label}
									</a>
								</li>
							))
						}
					</ul>
				</div>
				<div class="min-w-0">
					<h4 class="text-sm font-semibold text-white">Get in touch</h4>
					<ul class="mt-4 space-y-2.5 text-sm">
						<li>
							<a
								href={clinic.phoneHref}
								class="flex min-w-0 items-center gap-2 transition-colors hover:text-white"
							>
								<Icon name="phone" class="h-4 w-4 shrink-0" />
								<span class="break-all">{clinic.phoneDisplay}</span>
							</a>
						</li>
						<li>
							<a
								href={`mailto:${clinic.email}`}
								class="flex min-w-0 items-center gap-2 transition-colors hover:text-white"
							>
								<Icon name="mail" class="h-4 w-4 shrink-0" />
								<span class="break-all">{clinic.email}</span>
							</a>
						</li>
						<li>
							<a
								href={clinic.gmbHref}
								target="_blank"
								rel="noopener"
								class="flex min-w-0 items-center gap-2 transition-colors hover:text-white"
							>
								<Icon name="star" class="h-4 w-4 shrink-0" />
								<span>Google Business Profile</span>
							</a>
						</li>
						{
							clinic.socials.map((s) => (
								<li>
									<a
										href={s.href}
										target="_blank"
										rel="noopener"
										class="flex min-w-0 items-center gap-2 transition-colors hover:text-white"
									>
										<Icon name={s.icon} class="h-4 w-4 shrink-0" />
										<span>{s.label}</span>
									</a>
								</li>
							))
						}
					</ul>
				</div>
				{
					doctorProfiles.length > 0 && (
						<div class="min-w-0">
							<h4 class="text-sm font-semibold text-white">
								Our doctors on Google
							</h4>
							<ul class="mt-4 space-y-2.5 text-sm">
								{doctorProfiles.map((d) => (
									<li>
										<a
											href={d.profileHref}
											target="_blank"
											rel="noopener"
											class="flex min-w-0 items-start gap-2 transition-colors hover:text-white"
										>
											<Icon name="star" class="mt-0.5 h-4 w-4 shrink-0" />
											<span>{d.name}</span>
										</a>
									</li>
								))}
							</ul>
						</div>
					)
				}
			</div>
		</div>

		<div class="mt-12 border-t border-white/10 pt-6 text-xs text-white/50">
			© {year} {clinic.name}. All rights reserved.
		</div>
	</div>
</footer>
