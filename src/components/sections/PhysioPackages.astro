---
/**
 * PhysioPackages - pricing cards for physiotherapy consultation packages.
 * The "featured" package is visually lifted. Booking CTAs open the modal.
 */
import Section from "../ui/Section.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import Icon from "../ui/Icon.astro";
import MoreLink from "../ui/MoreLink.astro";
import { physioPackages, physioPackagesNote, clinic } from "../../data/site.ts";

interface Props {
	detailsHref?: string;
}

const { detailsHref } = Astro.props;
---

<Section id="packages" tone="alt">
	<SectionHeading
		eyebrow="Physiotherapy packages"
		title="Physiotherapy plans that save you more"
		subtitle="Guided by our rehabilitation specialist and Class 3B laser therapy. Choose a single session or a multi-session package for better value."
	/>

	<div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
		{
			physioPackages.map((pkg, i) => (
				<article
					data-reveal
					style={`--reveal-delay:${i * 80}ms`}
					class={`relative flex flex-col rounded-card border p-6 shadow-card transition duration-200 hover:-translate-y-1 hover:shadow-card-hover ${
						pkg.featured
							? "border-brand bg-surface ring-1 ring-brand"
							: "border-line bg-surface"
					}`}
				>
					{pkg.featured && (
						<span class="absolute -top-3 left-6 inline-flex items-center rounded-pill bg-brand px-3 py-1 text-xs font-semibold text-white">
							Most popular
						</span>
					)}
					<h3 class="text-base font-bold text-ink">{pkg.name}</h3>
					<p class="mt-1 text-sm text-ink-subtle">{pkg.sessions}</p>

					<div class="mt-4 flex items-baseline gap-2">
						<span class="text-3xl font-extrabold text-ink">{pkg.price}</span>
						{pkg.saving && (
							<span class="rounded-pill bg-brand-tint px-2 py-0.5 text-xs font-semibold text-brand-dark">
								{pkg.saving}
							</span>
						)}
					</div>
					{pkg.perSession && (
						<p class="mt-1 text-sm font-medium text-brand">{pkg.perSession}</p>
					)}

					<p class="mt-4 text-sm leading-relaxed text-ink-muted">
						{pkg.description}
					</p>

					<p class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-ink">
						<Icon name="clock" class="h-4 w-4 text-brand" />
						{pkg.validity}
					</p>

					<a
						href={clinic.whatsappHref}
						data-booking-trigger="true"
						data-service="Advanced Physiotherapy & Rehabilitation"
						class={`mt-6 inline-flex items-center justify-center gap-2 rounded-pill px-5 py-2.5 text-sm font-semibold transition-colors ${
							pkg.featured
								? "bg-brand text-white hover:bg-brand-dark"
								: "border border-brand text-brand hover:bg-brand-tint"
						}`}
					>
						Book this plan
					</a>
				</article>
			))
		}
	</div>

	<p class="mt-8 text-center text-sm text-ink-muted">
		<span class="text-brand">*</span>
		{physioPackagesNote}
	</p>

	{
		detailsHref && (
			<div class="mt-8 text-center">
				<MoreLink href={detailsHref} label="See physiotherapy details" />
			</div>
		)
	}
</Section>
