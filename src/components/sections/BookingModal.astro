---
/**
 * BookingModal - native <dialog> that collects patient details and opens
 * WhatsApp with a pre-filled message built from the form values.
 *
 * Trigger it from anywhere by adding `data-booking-trigger` to a link/button.
 * Optionally add `data-service="<service name>"` on the trigger to pre-select
 * that service (e.g. a physiotherapy package button).
 *
 * The trigger's own href (the plain wa.me link) is the no-JS fallback: if the
 * script never runs, clicking still opens WhatsApp normally.
 */
import Icon from "../ui/Icon.astro";
import WhatsAppIcon from "../ui/WhatsAppIcon.astro";
import { clinic, services } from "../../data/site.ts";

const field =
	"w-full rounded-card border border-line bg-surface px-4 py-2.5 text-sm text-ink placeholder:text-ink-subtle transition focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/25";
---

<dialog
	id="booking-dialog"
	data-whatsapp={clinic.whatsappNumber}
	class="m-auto max-h-[92dvh] w-[calc(100%-1.5rem)] max-w-lg overflow-y-auto rounded-card border border-line bg-surface p-0 shadow-card max-sm:m-0 max-sm:h-dvh max-sm:max-h-dvh max-sm:w-full max-sm:max-w-none max-sm:flex max-sm:flex-col max-sm:overflow-hidden max-sm:rounded-none max-sm:border-0"
	aria-labelledby="booking-title"
>
	<!-- header -->
	<div
		class="flex items-center gap-3 border-b border-line bg-brand-tint px-4 py-3 max-sm:shrink-0 sm:items-start sm:gap-4 sm:px-6 sm:py-5"
	>
		<button
			id="bk-back"
			type="button"
			class="-ml-1 inline-flex items-center gap-1.5 rounded-pill px-2 py-1.5 text-sm font-semibold text-ink transition-colors hover:bg-surface sm:hidden"
			aria-label="Back"
		>
			<Icon name="arrow-right" class="h-5 w-5 rotate-180" />
			Back
		</button>
		<span
			class="hidden h-11 w-11 shrink-0 items-center justify-center rounded-card bg-brand text-white shadow-card sm:flex"
		>
			<WhatsAppIcon class="h-6 w-6" />
		</span>
		<div class="min-w-0">
			<h2 id="booking-title" class="text-lg font-bold text-ink sm:text-xl">
				Book an appointment
			</h2>
			<p class="mt-1 hidden text-sm text-ink-muted sm:block">
				Share a few details and we'll confirm your slot on WhatsApp.
			</p>
		</div>
		<button
			id="bk-close"
			type="button"
			class="-mr-1 -mt-1 ml-auto hidden h-9 w-9 shrink-0 items-center justify-center rounded-pill text-ink-muted transition-colors hover:bg-surface hover:text-ink sm:flex"
			aria-label="Close"
		>
			<Icon name="close" class="h-5 w-5" />
		</button>
	</div>

	<form
		id="booking-form"
		class="grid gap-4 px-6 py-6 max-sm:min-h-0 max-sm:flex-1 max-sm:content-start max-sm:overflow-y-auto"
		novalidate
	>
		<div class="grid gap-4 sm:grid-cols-2">
			<div class="grid gap-1.5">
				<label for="bk-name" class="text-sm font-semibold text-ink">
					Patient name <span class="text-brand">*</span>
				</label>
				<input
					id="bk-name"
					name="name"
					type="text"
					required
					autocomplete="name"
					placeholder="Full name"
					aria-describedby="bk-name-error"
					class={field}
				/>
				<p
					id="bk-name-error"
					class="hidden text-xs font-medium text-red-600"
				>
				</p>
			</div>

			<div class="grid gap-1.5">
				<label for="bk-phone" class="text-sm font-semibold text-ink">
					Phone number <span class="text-brand">*</span>
				</label>
				<input
					id="bk-phone"
					name="phone"
					type="tel"
					required
					inputmode="tel"
					autocomplete="tel"
					placeholder="e.g. 98765 43210"
					aria-describedby="bk-phone-error"
					class={field}
				/>
				<p
					id="bk-phone-error"
					class="hidden text-xs font-medium text-red-600"
				>
				</p>
			</div>
		</div>

		<div class="grid gap-1.5">
			<label for="bk-service" class="text-sm font-semibold text-ink">
				Service
			</label>
			<select id="bk-service" name="service" class={field}>
				<option value="">Choose a service (optional)</option>
				{services.map((s) => <option value={s.name}>{s.name}</option>)}
				<option value="General enquiry">General enquiry</option>
			</select>
		</div>

		<div class="grid gap-4 sm:grid-cols-2">
			<div class="grid gap-1.5">
				<label for="bk-date" class="text-sm font-semibold text-ink">
					Preferred date
				</label>
				<div class="relative">
					<input
						id="bk-date"
						name="date"
						type="date"
						onclick="try{this.showPicker()}catch(e){}"
						oninput="this.classList.toggle('has-value', !!this.value)"
						class={`${field} dt-field`}
					/>
					<span
						class="dt-ph pointer-events-none absolute inset-y-0 left-4 flex items-center text-sm text-ink-subtle"
					>
						Select a date
					</span>
				</div>
			</div>
			<div class="grid gap-1.5">
				<label for="bk-time" class="text-sm font-semibold text-ink">
					Preferred time
				</label>
				<div class="relative">
					<input
						id="bk-time"
						name="time"
						type="time"
						onclick="try{this.showPicker()}catch(e){}"
						oninput="this.classList.toggle('has-value', !!this.value)"
						class={`${field} dt-field`}
					/>
					<span
						class="dt-ph pointer-events-none absolute inset-y-0 left-4 flex items-center text-sm text-ink-subtle"
					>
						Select a time
					</span>
				</div>
			</div>
		</div>

		<div class="grid gap-1.5">
			<label for="bk-notes" class="text-sm font-semibold text-ink">
				Notes <span class="font-normal text-ink-subtle">(optional)</span>
			</label>
			<textarea
				id="bk-notes"
				name="notes"
				rows="3"
				placeholder="Symptoms, preferred doctor, or anything else."
				class={`${field} resize-none`}></textarea>
		</div>

		<button
			type="submit"
			class="mt-1 inline-flex items-center justify-center gap-2 rounded-pill bg-brand px-7 py-3.5 text-base font-semibold text-white transition-colors hover:bg-brand-dark"
		>
			<WhatsAppIcon class="h-5 w-5" />
			Continue on WhatsApp
		</button>
	</form>

	<!-- reassurance footer -->
	<div
		class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1 border-t border-line bg-surface-alt px-6 py-4 text-xs text-ink-muted max-sm:shrink-0"
	>
		<span class="inline-flex items-center gap-1.5">
			<Icon name="shield" class="h-4 w-4 text-brand" />
			No payment needed to book.
		</span>
		<span>
			Prefer to call?
			<a
				href={clinic.phoneHref}
				class="font-semibold text-brand hover:text-brand-dark"
			>
				{clinic.phoneDisplay}
			</a>
		</span>
	</div>
</dialog>

<script>
	const dialog = document.getElementById(
		"booking-dialog",
	) as HTMLDialogElement | null;
	const form = document.getElementById("booking-form") as HTMLFormElement | null;

	if (dialog && form) {
		const number = dialog.dataset.whatsapp ?? "";
		const reduce = window.matchMedia(
			"(prefers-reduced-motion: reduce)",
		).matches;

		const nameInput = form.elements.namedItem("name") as HTMLInputElement;
		const phoneInput = form.elements.namedItem("phone") as HTMLInputElement;
		const serviceSel = form.elements.namedItem("service") as HTMLSelectElement;
		const dateInput = form.elements.namedItem("date") as HTMLInputElement;
		const nameError = document.getElementById("bk-name-error");
		const phoneError = document.getElementById("bk-phone-error");

		let lastTrigger: HTMLElement | null = null;

		// Pick a message in the currently active language.
		const t = (en: string, hiStr: string) =>
			document.documentElement.getAttribute("data-lang") === "hi" ? hiStr : en;

		const setError = (
			input: HTMLInputElement,
			msgEl: HTMLElement | null,
			message: string,
		) => {
			input.setAttribute("aria-invalid", "true");
			input.classList.remove("border-line");
			input.classList.add("border-red-500");
			if (msgEl) {
				msgEl.textContent = message;
				msgEl.classList.remove("hidden");
			}
		};

		const clearError = (
			input: HTMLInputElement,
			msgEl: HTMLElement | null,
		) => {
			input.removeAttribute("aria-invalid");
			input.classList.remove("border-red-500");
			input.classList.add("border-line");
			if (msgEl) msgEl.classList.add("hidden");
		};

		nameInput.addEventListener("input", () => clearError(nameInput, nameError));
		phoneInput.addEventListener("input", () =>
			clearError(phoneInput, phoneError),
		);

		const openDialog = (event: Event) => {
			event.preventDefault();
			lastTrigger = event.currentTarget as HTMLElement;
			clearError(nameInput, nameError);
			clearError(phoneInput, phoneError);

			const preset = lastTrigger?.dataset.service ?? "";
			serviceSel.value = [...serviceSel.options].some((o) => o.value === preset)
				? preset
				: "";

			// Keep past dates out, and sync the placeholder overlay state.
			dateInput.min = new Date().toISOString().slice(0, 10);
			const timeInput = form.elements.namedItem("time") as HTMLInputElement;
			dateInput.classList.toggle("has-value", !!dateInput.value);
			timeInput.classList.toggle("has-value", !!timeInput.value);

			dialog.showModal();
			document.body.style.overflow = "hidden";
			requestAnimationFrame(() => dialog.classList.add("is-open"));
			nameInput.focus();
		};

		const closeDialog = () => {
			dialog.classList.remove("is-open");
			document.body.style.overflow = "";
			window.setTimeout(
				() => {
					if (dialog.open) dialog.close();
					lastTrigger?.focus();
				},
				reduce ? 0 : 250,
			);
		};

		document
			.querySelectorAll<HTMLElement>("[data-booking-trigger]")
			.forEach((el) => el.addEventListener("click", openDialog));

		document.getElementById("bk-close")?.addEventListener("click", closeDialog);
		document.getElementById("bk-back")?.addEventListener("click", closeDialog);
		dialog.addEventListener("click", (event) => {
			if (event.target === dialog) closeDialog();
		});
		dialog.addEventListener("cancel", (event) => {
			event.preventDefault();
			closeDialog();
		});

		const line = (label: string, value: string) =>
			value.trim() ? `${label}: ${value.trim()}\n` : "";

		form.addEventListener("submit", (event) => {
			event.preventDefault();
			const name = nameInput.value.trim();
			const phone = phoneInput.value.trim();
			const digits = phone.replace(/\D/g, "");
			let firstInvalid: HTMLInputElement | null = null;

			if (!name) {
				setError(
					nameInput,
					nameError,
					t("Please enter the patient's name.", "कृपया मरीज़ का नाम भरें।"),
				);
				firstInvalid = firstInvalid ?? nameInput;
			}
			if (!phone) {
				setError(
					phoneInput,
					phoneError,
					t("Please enter a phone number.", "कृपया फ़ोन नंबर भरें।"),
				);
				firstInvalid = firstInvalid ?? phoneInput;
			} else if (digits.length < 10) {
				setError(
					phoneInput,
					phoneError,
					t("Please enter a valid phone number.", "कृपया सही फ़ोन नंबर भरें।"),
				);
				firstInvalid = firstInvalid ?? phoneInput;
			}

			if (firstInvalid) {
				firstInvalid.focus();
				return;
			}

			const data = new FormData(form);
			let message = "Hello Devra Clinic, I'd like to book an appointment.\n\n";
			message += line("Name", name);
			message += line("Phone", phone);
			message += line("Service", String(data.get("service") ?? ""));
			message += line("Preferred date", String(data.get("date") ?? ""));
			message += line("Preferred time", String(data.get("time") ?? ""));
			message += line("Notes", String(data.get("notes") ?? ""));

			// Notify the clinic on Slack so they can follow up if the patient
			// never sends the WhatsApp message. Fire-and-forget, never blocks.
			const SLACK = import.meta.env.PUBLIC_SLACK_WEBHOOK_URL;
			if (SLACK) {
				const service = String(data.get("service") ?? "").trim();
				const date = String(data.get("date") ?? "").trim();
				const time = String(data.get("time") ?? "").trim();
				const notes = String(data.get("notes") ?? "").trim();

				// Make the phone a tap-to-WhatsApp link for quick follow-up.
				const digits = phone.replace(/\D/g, "");
				const wa =
					digits.length === 10 ? `91${digits}` : digits.length ? digits : "";
				const phoneMd = wa ? `<https://wa.me/${wa}|${phone}>` : phone;

				const fields = [`*Name:*\n${name}`, `*Phone:*\n${phoneMd}`];
				if (service) fields.push(`*Service:*\n${service}`);
				const when = [date, time].filter(Boolean).join(" at ");
				if (when) fields.push(`*Preferred:*\n${when}`);

				const blocks: Record<string, unknown>[] = [
					{
						type: "header",
						text: { type: "plain_text", text: "🔔 New booking lead", emoji: true },
					},
					{
						type: "section",
						fields: fields.map((t) => ({ type: "mrkdwn", text: t })),
					},
				];
				if (notes) {
					blocks.push({
						type: "section",
						text: { type: "mrkdwn", text: `*Notes:*\n${notes}` },
					});
				}
				blocks.push({
					type: "context",
					elements: [
						{
							type: "mrkdwn",
							text: `Tapped *Continue on WhatsApp* · ${location.pathname}`,
						},
					],
				});

				const body = JSON.stringify({
					text: `New booking lead: ${name} (${phone})`,
					blocks,
				});
				try {
					// text/plain avoids a CORS preflight Slack won't answer.
					const blob = new Blob([body], { type: "text/plain;charset=UTF-8" });
					if (!navigator.sendBeacon(SLACK, blob)) {
						fetch(SLACK, { method: "POST", mode: "no-cors", body, keepalive: true });
					}
				} catch (e) {
					/* never block the booking on a failed ping */
				}
			}

			const url = `https://wa.me/${number}?text=${encodeURIComponent(message.trim())}`;
			window.open(url, "_blank", "noopener");
			closeDialog();
			form.reset();
		});
	}
</script>
