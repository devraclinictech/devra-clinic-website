---
/**
 * BookingModal - native <dialog> that collects patient details and opens
 * WhatsApp with a pre-filled message built from the form values.
 *
 * Trigger it from anywhere by adding `data-booking-trigger` to a link/button.
 * Optionally add `data-service="<service name>"` on the trigger to pre-select
 * that service (e.g. a physiotherapy package button).
 *
 * The trigger's own href (the plain wa.me link) is the no-JS fallback: if the
 * script never runs, clicking still opens WhatsApp normally.
 */
import Icon from "../ui/Icon.astro";
import WhatsAppIcon from "../ui/WhatsAppIcon.astro";
import { clinic, services } from "../../data/site.ts";

// text-base (16px) on mobile stops iOS Safari from auto-zooming on focus.
// min-w-0 lets native date/time inputs shrink instead of overflowing.
const field =
	"w-full min-w-0 rounded-card border border-line bg-surface px-4 py-2.5 text-base sm:text-sm text-ink placeholder:text-ink-subtle transition focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/25";
---

<dialog
	id="booking-dialog"
	data-whatsapp={clinic.whatsappNumber}
	class="m-auto max-h-[92dvh] w-[calc(100%-1.5rem)] max-w-lg overflow-y-auto rounded-card border border-line bg-surface p-0 shadow-card max-sm:m-0 max-sm:h-dvh max-sm:max-h-dvh max-sm:w-full max-sm:max-w-none max-sm:flex max-sm:flex-col max-sm:overflow-hidden max-sm:rounded-none max-sm:border-0"
	aria-labelledby="booking-title"
>
	<!-- header -->
	<div
		class="flex items-center gap-3 border-b border-line bg-brand-tint px-4 py-3 max-sm:shrink-0 sm:items-start sm:gap-4 sm:px-6 sm:py-5"
	>
		<button
			id="bk-back"
			type="button"
			class="-ml-1 inline-flex items-center gap-1.5 rounded-pill px-2 py-1.5 text-sm font-semibold text-ink transition-colors hover:bg-surface sm:hidden"
			aria-label="Back"
		>
			<Icon name="arrow-right" class="h-5 w-5 rotate-180" />
			Back
		</button>
		<span
			class="hidden h-11 w-11 shrink-0 items-center justify-center rounded-card bg-brand text-white shadow-card sm:flex"
		>
			<WhatsAppIcon class="h-6 w-6" />
		</span>
		<div class="min-w-0">
			<h2 id="booking-title" class="text-lg font-bold text-ink sm:text-xl">
				Book an appointment
			</h2>
			<p class="mt-1 hidden text-sm text-ink-muted sm:block">
				Share a few details and we'll confirm your slot on WhatsApp.
			</p>
		</div>
		<button
			id="bk-close"
			type="button"
			class="-mr-1 -mt-1 ml-auto hidden h-9 w-9 shrink-0 items-center justify-center rounded-pill text-ink-muted transition-colors hover:bg-surface hover:text-ink sm:flex"
			aria-label="Close"
		>
			<Icon name="close" class="h-5 w-5" />
		</button>
	</div>

	<form
		id="booking-form"
		class="grid gap-4 px-6 py-6 max-sm:min-h-0 max-sm:flex-1 max-sm:content-start max-sm:overflow-x-hidden max-sm:overflow-y-auto"
		novalidate
	>
		<div class="grid gap-4 sm:grid-cols-2">
			<div class="grid gap-1.5">
				<label for="bk-name" class="text-sm font-semibold text-ink">
					Patient name <span class="text-brand">*</span>
				</label>
				<input
					id="bk-name"
					name="name"
					type="text"
					required
					autocomplete="name"
					placeholder="Full name"
					aria-describedby="bk-name-error"
					class={field}
				/>
				<p
					id="bk-name-error"
					class="hidden text-xs font-medium text-red-600"
				>
				</p>
			</div>

			<div class="grid gap-1.5">
				<label for="bk-phone" class="text-sm font-semibold text-ink">
					Phone number <span class="text-brand">*</span>
				</label>
				<input
					id="bk-phone"
					name="phone"
					type="tel"
					required
					inputmode="tel"
					autocomplete="tel"
					placeholder="e.g. 98765 43210"
					aria-describedby="bk-phone-error"
					class={field}
				/>
				<p
					id="bk-phone-error"
					class="hidden text-xs font-medium text-red-600"
				>
				</p>
			</div>
		</div>

		<div class="grid gap-1.5">
			<label for="bk-service" class="text-sm font-semibold text-ink">
				Service
			</label>
			<select id="bk-service" name="service" class={field}>
				<option value="">Choose a service (optional)</option>
				{services.map((s) => <option value={s.name}>{s.name}</option>)}
				<option value="General enquiry">General enquiry</option>
			</select>
		</div>

		<div class="grid gap-1.5">
			<label for="bk-date" class="text-sm font-semibold text-ink">
				Preferred date
			</label>
			<input
				id="bk-date"
				name="date"
				type="date"
				onclick="try{this.showPicker()}catch(e){}"
				onchange="var f=document.getElementById('booking-form');f.scrollTo({top:f.scrollHeight,behavior:'smooth'});this.closest('dialog').scrollTo({top:99999,behavior:'smooth'})"
				class={field}
			/>
		</div>

		<div class="grid gap-1.5">
			<span id="bk-time-label" class="text-sm font-semibold text-ink">
				Preferred time
			</span>
			<!-- Hidden value is set by the slot chips below; keeps FormData.time working. -->
			<input id="bk-time" name="time" type="hidden" />
			<!-- display is driven from JS: an inline style beats Tailwind display utils. -->
			<div
				id="bk-time-slots"
				role="group"
				aria-labelledby="bk-time-label"
				aria-describedby="bk-time-hint bk-time-error"
				class="grid grid-cols-4 gap-2"
				style="display:none"
			>
			</div>
			<p id="bk-time-hint" class="text-xs text-ink-muted" aria-live="polite">
			</p>
			<p
				id="bk-time-error"
				class="hidden text-xs font-medium text-red-600"
				aria-live="polite"
			>
			</p>
		</div>

		<div class="grid gap-1.5">
			<label for="bk-notes" class="text-sm font-semibold text-ink">
				Notes <span class="font-normal text-ink-subtle">(optional)</span>
			</label>
			<textarea
				id="bk-notes"
				name="notes"
				rows="3"
				placeholder="Symptoms, preferred doctor, or anything else."
				class={`${field} resize-none`}></textarea>
		</div>

	</form>

	<!-- Pinned action bar: primary CTA stays visible, plus reassurance. -->
	<div class="border-t border-line bg-surface px-6 pb-5 pt-4 max-sm:shrink-0">
		<button
			type="submit"
			form="booking-form"
			class="inline-flex w-full items-center justify-center gap-2 rounded-pill bg-brand px-7 py-3.5 text-base font-semibold text-white transition-colors hover:bg-brand-dark"
		>
			<WhatsAppIcon class="h-5 w-5" />
			Continue on WhatsApp
		</button>
		<div
			class="mt-3 flex flex-wrap items-center justify-between gap-x-4 gap-y-1 text-xs text-ink-muted"
		>
			<span class="inline-flex items-center gap-1.5">
				<Icon name="shield" class="h-4 w-4 text-brand" />
				No payment needed to book.
			</span>
			<span>
				Prefer to call?
				<a
					href={clinic.phoneHref}
					class="font-semibold text-brand hover:text-brand-dark"
				>
					{clinic.phoneDisplay}
				</a>
			</span>
		</div>
	</div>
</dialog>

<script>
	import { bookingWindows } from "../../data/site.ts";

	const dialog = document.getElementById(
		"booking-dialog",
	) as HTMLDialogElement | null;
	const form = document.getElementById("booking-form") as HTMLFormElement | null;

	if (dialog && form) {
		const number = dialog.dataset.whatsapp ?? "";
		const reduce = window.matchMedia(
			"(prefers-reduced-motion: reduce)",
		).matches;

		const nameInput = form.elements.namedItem("name") as HTMLInputElement;
		const phoneInput = form.elements.namedItem("phone") as HTMLInputElement;
		const serviceSel = form.elements.namedItem("service") as HTMLSelectElement;
		const dateInput = form.elements.namedItem("date") as HTMLInputElement;
		const timeInput = form.elements.namedItem("time") as HTMLInputElement;
		const nameError = document.getElementById("bk-name-error");
		const phoneError = document.getElementById("bk-phone-error");
		const timeError = document.getElementById("bk-time-error");
		const timeHint = document.getElementById("bk-time-hint");
		const timeSlots = document.getElementById("bk-time-slots");

		const DAYS = [
			"Sunday",
			"Monday",
			"Tuesday",
			"Wednesday",
			"Thursday",
			"Friday",
			"Saturday",
		];
		const to12 = (hhmm: string) => {
			const [h, m] = hhmm.split(":").map(Number);
			const ap = h < 12 ? "AM" : "PM";
			const h12 = h % 12 || 12;
			return `${h12}:${String(m).padStart(2, "0")} ${ap}`;
		};
		const fmtWindows = (wins: [string, string][]) =>
			wins.map(([a, b]) => `${to12(a)} to ${to12(b)}`).join(" and ");

		// Discrete appointment slots offered as chips. 30-min steps, always
		// including the exact window end (e.g. 9:50) even when it is off-step.
		const SLOT_STEP = 30;
		// Walk-in services have no booking window, so offer hourly slots across
		// general clinic hours as a convenience "preferred time".
		const CLINIC_HOURS: [string, string] = ["08:30", "20:00"];
		const toMin = (hhmm: string) => {
			const [h, m] = hhmm.split(":").map(Number);
			return h * 60 + m;
		};
		const toHHMM = (min: number) =>
			`${String(Math.floor(min / 60)).padStart(2, "0")}:${String(min % 60).padStart(2, "0")}`;
		const slotsFor = (wins: [string, string][], step = SLOT_STEP) => {
			const out: string[] = [];
			for (const [a, b] of wins) {
				for (let t = toMin(a); t <= toMin(b); t += step) out.push(toHHMM(t));
				if (out[out.length - 1] !== b) out.push(b);
			}
			return out;
		};
		const CHIP_IDLE =
			"w-full whitespace-nowrap rounded-pill border border-line bg-surface px-2 py-1.5 text-center text-xs text-ink transition-colors hover:border-brand hover:text-brand sm:text-sm";
		const CHIP_ON =
			"w-full whitespace-nowrap rounded-pill border border-brand bg-brand px-2 py-1.5 text-center text-xs font-semibold text-white sm:text-sm";
		// Allowed windows for a service on the date's weekday.
		// null = walk-in (no slot); [] = closed that day; otherwise the windows.
		const dayWindows = (svc: string, dateStr: string) => {
			const cfg = bookingWindows[svc];
			if (!cfg) return null;
			if (!dateStr) return undefined;
			const day = new Date(`${dateStr}T00:00`).getDay();
			return cfg[day] ?? [];
		};

		// Keep the helper line under the time field in step with service + date.
		const updateTimeHint = () => {
			if (!timeHint) return;
			const svc = serviceSel.value;
			const cfg = bookingWindows[svc];
			if (!cfg) {
				timeHint.textContent = svc
					? "Walk-in service, no appointment needed. Pick a preferred time if you like."
					: "Pick a preferred time, or choose a service above first.";
				return;
			}
			if (!dateInput.value) {
				timeHint.textContent = `Choose a date to see available times for ${svc}.`;
				return;
			}
			const wins = dayWindows(svc, dateInput.value) as [string, string][];
			const weekday = DAYS[new Date(`${dateInput.value}T00:00`).getDay()];
			timeHint.textContent = wins.length
				? `Available on ${weekday}: ${fmtWindows(wins)}.`
				: `${svc} is not available on ${weekday}. Please pick another day.`;
		};

		let lastTrigger: HTMLElement | null = null;
		let submitted = false;
		let abandonedSent = false;
		const SLACK = import.meta.env.PUBLIC_SLACK_WEBHOOK_URL;

		const postSlack = (text: string, blocks: Record<string, unknown>[]) => {
			if (!SLACK) return;
			const body = JSON.stringify({ text, blocks });
			try {
				// text/plain avoids a CORS preflight Slack won't answer.
				const blob = new Blob([body], { type: "text/plain;charset=UTF-8" });
				if (!navigator.sendBeacon(SLACK, blob)) {
					fetch(SLACK, { method: "POST", mode: "no-cors", body, keepalive: true });
				}
			} catch (e) {
				/* never block the booking on a failed ping */
			}
		};

		// A tap-to-WhatsApp link for the phone number.
		const waLink = (phone: string) => {
			const d = phone.replace(/\D/g, "");
			const wa = d.length === 10 ? `91${d}` : d.length ? d : "";
			return wa ? `<https://wa.me/${wa}|${phone}>` : phone;
		};

		// Patient entered a usable phone but left without tapping Continue:
		// send a call-back request so the clinic can reach out.
		const sendAbandoned = () => {
			if (submitted || abandonedSent) return;
			const phone = phoneInput.value.trim();
			if (phone.replace(/\D/g, "").length < 10) return;
			abandonedSent = true;
			const name = nameInput.value.trim();
			const service = serviceSel.value.trim();
			const fields = [`*Phone:*\n${waLink(phone)}`];
			if (name) fields.unshift(`*Name:*\n${name}`);
			if (service) fields.push(`*Service:*\n${service}`);
			postSlack(`Call-back request: ${name || "no name"} (${phone})`, [
				{
					type: "header",
					text: { type: "plain_text", text: "📞 Call-back request", emoji: true },
				},
				{
					type: "section",
					text: {
						type: "mrkdwn",
						text: "Patient started a booking and left *without finishing*. Please call them back.",
					},
				},
				{
					type: "section",
					fields: fields.map((x) => ({ type: "mrkdwn", text: x })),
				},
				{
					type: "context",
					elements: [
						{
							type: "mrkdwn",
							text: `Did not tap Continue on WhatsApp · ${location.pathname}`,
						},
					],
				},
			]);
		};

		// Pick a message in the currently active language.
		const t = (en: string, hiStr: string) =>
			document.documentElement.getAttribute("data-lang") === "hi" ? hiStr : en;

		const setError = (
			input: HTMLInputElement,
			msgEl: HTMLElement | null,
			message: string,
		) => {
			input.setAttribute("aria-invalid", "true");
			input.classList.remove("border-line");
			input.classList.add("border-red-500");
			if (msgEl) {
				msgEl.textContent = message;
				msgEl.classList.remove("hidden");
			}
		};

		const clearError = (
			input: HTMLInputElement,
			msgEl: HTMLElement | null,
		) => {
			input.removeAttribute("aria-invalid");
			input.classList.remove("border-red-500");
			input.classList.add("border-line");
			if (msgEl) msgEl.classList.add("hidden");
		};

		const clearTimeError = () => clearError(timeInput, timeError);

		const selectSlot = (btn: HTMLButtonElement, value: string) => {
			timeInput.value = value;
			clearTimeError();
			timeSlots?.querySelectorAll("button").forEach((b) => {
				b.className = CHIP_IDLE;
				b.setAttribute("aria-pressed", "false");
			});
			btn.className = CHIP_ON;
			btn.setAttribute("aria-pressed", "true");
		};

		// Rebuild the slot chips for the current service + date, and keep the
		// hint line in step. Clears any stale selection.
		const renderTime = () => {
			updateTimeHint();
			if (!timeSlots) return;
			timeSlots.innerHTML = "";
			timeInput.value = "";
			const svc = serviceSel.value;
			const cfg = bookingWindows[svc];
			let wins: [string, string][] = [];
			let step = SLOT_STEP;
			if (cfg) {
				wins = dateInput.value
					? (dayWindows(svc, dateInput.value) as [string, string][])
					: [];
			} else {
				// Walk-in or no service yet: hourly slots across clinic hours.
				wins = [CLINIC_HOURS];
				step = 60;
			}
			if (!wins.length) {
				timeSlots.style.display = "none";
				return;
			}
			// Clear the inline hide so the grid classes take over.
			timeSlots.style.display = "";
			for (const s of slotsFor(wins, step)) {
				const btn = document.createElement("button");
				btn.type = "button";
				btn.textContent = to12(s);
				btn.className = CHIP_IDLE;
				btn.setAttribute("aria-pressed", "false");
				btn.addEventListener("click", () => selectSlot(btn, s));
				timeSlots.appendChild(btn);
			}
		};

		nameInput.addEventListener("input", () => clearError(nameInput, nameError));
		phoneInput.addEventListener("input", () =>
			clearError(phoneInput, phoneError),
		);
		serviceSel.addEventListener("change", renderTime);
		dateInput.addEventListener("change", renderTime);

		const openDialog = (trigger: HTMLElement | null) => {
			lastTrigger = trigger;
			clearError(nameInput, nameError);
			clearError(phoneInput, phoneError);

			const preset = trigger?.dataset.service ?? "";
			serviceSel.value = [...serviceSel.options].some((o) => o.value === preset)
				? preset
				: "";

			// Keep past dates out of the picker.
			dateInput.min = new Date().toISOString().slice(0, 10);

			clearTimeError();
			renderTime();

			dialog.showModal();
			document.body.style.overflow = "hidden";
			requestAnimationFrame(() => dialog.classList.add("is-open"));
			nameInput.focus();
		};

		const closeDialog = () => {
			sendAbandoned();
			dialog.classList.remove("is-open");
			document.body.style.overflow = "";
			window.setTimeout(
				() => {
					if (dialog.open) dialog.close();
					lastTrigger?.focus();
				},
				reduce ? 0 : 250,
			);
		};

		document
			.querySelectorAll<HTMLElement>("[data-booking-trigger]")
			.forEach((el) =>
				el.addEventListener("click", (e) => {
					e.preventDefault();
					openDialog(el);
				}),
			);

		// Deep link: /?appointment (optionally &service=Name) opens the form on
		// load. /?book and the #appointment/#book hashes also work.
		const bookParams = new URLSearchParams(location.search);
		const wantsForm =
			bookParams.has("appointment") ||
			bookParams.has("book") ||
			location.hash === "#appointment" ||
			location.hash === "#book";
		if (wantsForm) {
			openDialog(null);
			const svc = bookParams.get("service");
			if (svc && [...serviceSel.options].some((o) => o.value === svc)) {
				serviceSel.value = svc;
				renderTime();
			}
		}

		document.getElementById("bk-close")?.addEventListener("click", closeDialog);
		document.getElementById("bk-back")?.addEventListener("click", closeDialog);
		// Intentionally no backdrop-click-to-close: the modal only closes via the
		// Close/Back buttons (or Escape), so an accidental overlay tap keeps the
		// half-filled form instead of discarding it.
		dialog.addEventListener("cancel", (event) => {
			event.preventDefault();
			closeDialog();
		});

		// Leaving the tab/page with the form open and a phone filled: still ping.
		const onLeave = () => {
			if (dialog.open) sendAbandoned();
		};
		document.addEventListener("visibilitychange", () => {
			if (document.visibilityState === "hidden") onLeave();
		});
		window.addEventListener("pagehide", onLeave);

		const line = (label: string, value: string) =>
			value.trim() ? `${label}: ${value.trim()}\n` : "";

		form.addEventListener("submit", (event) => {
			event.preventDefault();
			const name = nameInput.value.trim();
			const phone = phoneInput.value.trim();
			const digits = phone.replace(/\D/g, "");
			let firstInvalid: HTMLInputElement | null = null;

			if (!name) {
				setError(
					nameInput,
					nameError,
					t("Please enter the patient's name.", "कृपया मरीज़ का नाम भरें।"),
				);
				firstInvalid = firstInvalid ?? nameInput;
			}
			if (!phone) {
				setError(
					phoneInput,
					phoneError,
					t("Please enter a phone number.", "कृपया फ़ोन नंबर भरें।"),
				);
				firstInvalid = firstInvalid ?? phoneInput;
			} else if (digits.length < 10) {
				setError(
					phoneInput,
					phoneError,
					t("Please enter a valid phone number.", "कृपया सही फ़ोन नंबर भरें।"),
				);
				firstInvalid = firstInvalid ?? phoneInput;
			}

			// Consultation services must fall inside their booking window.
			clearTimeError();
			const svc = serviceSel.value;
			if (bookingWindows[svc]) {
				const date = dateInput.value;
				const time = timeInput.value;
				if (!date) {
					setError(
						timeInput,
						timeError,
						t(
							`Please choose a date for your ${svc}.`,
							`कृपया अपने ${svc} के लिए तारीख़ चुनें।`,
						),
					);
					firstInvalid = firstInvalid ?? dateInput;
				} else {
					const wins = dayWindows(svc, date) as [string, string][];
					const weekday = DAYS[new Date(`${date}T00:00`).getDay()];
					if (!wins.length) {
						setError(
							timeInput,
							timeError,
							t(
								`${svc} is not available on ${weekday}. Please pick another day.`,
								`${weekday} को ${svc} उपलब्ध नहीं है। कृपया दूसरा दिन चुनें।`,
							),
						);
						firstInvalid = firstInvalid ?? dateInput;
					} else if (!time) {
						setError(
							timeInput,
							timeError,
							t("Please pick an appointment time.", "कृपया अपॉइंटमेंट का समय चुनें।"),
						);
						// Hidden input can't take focus; send it to the first chip.
						if (!firstInvalid)
							(timeSlots?.querySelector("button") as HTMLButtonElement)?.focus();
						firstInvalid = firstInvalid ?? timeInput;
					} else if (!wins.some(([a, b]) => time >= a && time <= b)) {
						setError(
							timeInput,
							timeError,
							t(
								`Please choose a time within: ${fmtWindows(wins)}.`,
								`कृपया इस समय सीमा में चुनें: ${fmtWindows(wins)}।`,
							),
						);
						firstInvalid = firstInvalid ?? timeInput;
					}
				}
			}

			if (firstInvalid) {
				firstInvalid.focus();
				return;
			}

			submitted = true;
			const data = new FormData(form);
			let message = "Hello Devra Clinic, I'd like to book an appointment.\n\n";
			message += line("Name", name);
			message += line("Phone", phone);
			message += line("Service", String(data.get("service") ?? ""));
			message += line("Preferred date", String(data.get("date") ?? ""));
			const timeVal = String(data.get("time") ?? "").trim();
			message += line("Preferred time", timeVal ? to12(timeVal) : "");
			message += line("Notes", String(data.get("notes") ?? ""));

			// Notify the clinic on Slack so they can follow up even if the patient
			// never sends the WhatsApp message. Fire-and-forget, never blocks.
			const service = String(data.get("service") ?? "").trim();
			const date = String(data.get("date") ?? "").trim();
			const time = String(data.get("time") ?? "").trim();
			const notes = String(data.get("notes") ?? "").trim();

			const fields = [`*Name:*\n${name}`, `*Phone:*\n${waLink(phone)}`];
			if (service) fields.push(`*Service:*\n${service}`);
			const when = [date, time && to12(time)].filter(Boolean).join(" at ");
			if (when) fields.push(`*Preferred:*\n${when}`);

			const blocks: Record<string, unknown>[] = [
				{
					type: "header",
					text: { type: "plain_text", text: "🔔 New booking lead", emoji: true },
				},
				{
					type: "section",
					fields: fields.map((x) => ({ type: "mrkdwn", text: x })),
				},
			];
			if (notes) {
				blocks.push({
					type: "section",
					text: { type: "mrkdwn", text: `*Notes:*\n${notes}` },
				});
			}
			blocks.push({
				type: "context",
				elements: [
					{
						type: "mrkdwn",
						text: `Tapped *Continue on WhatsApp* · ${location.pathname}`,
					},
				],
			});
			postSlack(`New booking lead: ${name} (${phone})`, blocks);

			const url = `https://wa.me/${number}?text=${encodeURIComponent(message.trim())}`;
			window.open(url, "_blank", "noopener");
			closeDialog();
			form.reset();
		});
	}
</script>
